# Quarto internal cache (search index, xrefs, scratch state) - not needed in version control
/.quarto/

# Rendered book output - regenerated by the GitHub Actions publish workflow
/_book/

# NOTE: /_freeze/ is intentionally NOT ignored. It holds cached execution
# results (freeze: auto in _quarto.yml) so CI can skip re-running unchanged
# R chunks and so renders stay reproducible without R installed locally.

# R
.Rproj.user/
.Rhistory
.RData
.Ruserdata
renv/

# Internal course planning docs - kept out of this public repo
course outline.docx
inclass activities suggestions.docx

# Local tool config
.claude/

# OS cruft
.DS_Store
Thumbs.db

**/*.quarto_ipynb
Rplots.pdf
